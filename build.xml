<?xml version="1.0" encoding="UTF-8"?>
<project name="thuvien" default="default" basedir=".">
    <description>Builds, tests, and runs the Remote School Library Management System.</description>
    <import file="nbproject/build-impl.xml"/>

    <!-- ================================================================= -->
    <!-- Modular Compilation Override                                      -->
    <!-- Enforces strict separation:                                       -->
    <!-- 1. common: zero dependencies (no Swing, no JDBC)                 -->
    <!-- 2. server: common + MySQL + HikariCP + SLF4J (no Swing)          -->
    <!-- 3. client: common only (no MySQL, no JDBC, no HikariCP)           -->
    <!-- ================================================================= -->

    <target name="-do-compile" depends="init,deps-jar,-pre-pre-compile,-pre-compile">
        <!-- 1. Compile common module -->
        <echo message="[ANT] Compiling common module (common/src)..."/>
        <mkdir dir="${build.classes.dir}"/>
        <javac srcdir="common/src"
               destdir="${build.classes.dir}"
               source="${javac.source}"
               target="${javac.target}"
               encoding="${source.encoding}"
               debug="${javac.debug}"
               includeantruntime="false">
            <classpath path=""/>
        </javac>

        <!-- 2. Compile server module with database libraries -->
        <echo message="[ANT] Compiling server module (server/src) with HikariCP and MySQL..."/>
        <javac srcdir="server/src"
               destdir="${build.classes.dir}"
               source="${javac.source}"
               target="${javac.target}"
               encoding="${source.encoding}"
               debug="${javac.debug}"
               includeantruntime="false">
            <classpath>
                <pathelement location="${build.classes.dir}"/>
                <path path="${javac.classpath}"/>
            </classpath>
        </javac>

        <!-- 3. Compile client module with STRICT ZERO DATABASE DEPENDENCIES -->
        <echo message="[ANT] Compiling client module (client/src) with ZERO database dependencies..."/>
        <javac srcdir="client/src"
               destdir="${build.classes.dir}"
               source="${javac.source}"
               target="${javac.target}"
               encoding="${source.encoding}"
               debug="${javac.debug}"
               includeantruntime="false">
            <classpath>
                <!-- Only common classes in build.classes.dir, NO JDBC JARs -->
                <pathelement location="${build.classes.dir}"/>
            </classpath>
        </javac>

        <!-- 4. Copy runtime configuration resources -->
        <echo message="[ANT] Copying configuration resources..."/>
        <copy todir="${build.classes.dir}" failonerror="false">
            <fileset dir="common/src" excludes="**/*.java"/>
            <fileset dir="server/src" excludes="**/*.java"/>
            <fileset dir="server/resources" erroronmissingdir="false"/>
            <fileset dir="client/src" excludes="**/*.java"/>
            <fileset dir="client/resources" erroronmissingdir="false"/>
        </copy>
    </target>

    <!-- Target to run the Library RMI Server -->
    <target name="run-rmi-server" depends="compile" description="Runs the Library Java RMI Server">
        <java classname="thuvien.server.rmi.LibraryRMIServer" fork="true">
            <classpath>
                <path path="${run.classpath}"/>
            </classpath>
        </java>
    </target>

    <!-- Target to run the Library RMI Swing Client -->
    <target name="run-rmi-client" depends="compile" description="Runs the Library Swing Client over Java RMI">
        <java classname="thuvien.client.ClientMain" fork="true">
            <classpath>
                <pathelement location="${build.classes.dir}"/>
            </classpath>
        </java>
    </target>

    <!-- Target to run the Library Server (defaults to RMI Server) -->
    <target name="run-server" depends="compile" description="Runs the Library Server">
        <java classname="thuvien.server.rmi.LibraryRMIServer" fork="true">
            <classpath>
                <path path="${run.classpath}"/>
            </classpath>
        </java>
    </target>

    <!-- Target to run the Library Swing Client -->
    <target name="run-client" depends="compile" description="Runs the Library Swing Client">
        <java classname="thuvien.client.ClientMain" fork="true">
            <classpath>
                <pathelement location="${build.classes.dir}"/>
            </classpath>
        </java>
    </target>

    <!-- ================================================================= -->
    <!-- Isolated Server & Client Distribution Packaging                   -->
    <!-- ================================================================= -->

    <target name="package-server" depends="compile" description="Packages isolated Server distribution into dist/server-dist">
        <property name="server.dist.dir" value="${dist.dir}/server-dist"/>
        <delete dir="${server.dist.dir}"/>
        <mkdir dir="${server.dist.dir}"/>
        <mkdir dir="${server.dist.dir}/lib"/>
        <mkdir dir="${server.dist.dir}/resources"/>

        <!-- Copy external runtime libraries required by Server -->
        <copy todir="${server.dist.dir}/lib">
            <fileset dir="lib">
                <include name="mysql-connector-java-8.0.33.jar"/>
                <include name="HikariCP-4.0.3.jar"/>
                <include name="slf4j-api-1.7.36.jar"/>
                <include name="slf4j-jdk14-1.7.36.jar"/>
            </fileset>
        </copy>

        <!-- Copy externalized Server configuration files -->
        <copy todir="${server.dist.dir}/resources" failonerror="false">
            <fileset dir="server/resources" includes="server.properties,db.properties,db.properties.example"/>
        </copy>

        <!-- Build server.jar with ONLY common + server classes (NO client GUI, NO tests) -->
        <jar destfile="${server.dist.dir}/server.jar">
            <fileset dir="${build.classes.dir}">
                <include name="thuvien/common/**"/>
                <include name="thuvien/server/**"/>
                <include name="server.properties"/>
                <include name="db.properties"/>
                <exclude name="thuvien/client/**"/>
                <exclude name="client.properties"/>
            </fileset>
            <manifest>
                <attribute name="Main-Class" value="thuvien.server.rmi.LibraryRMIServer"/>
                <attribute name="Class-Path" value="resources/ lib/mysql-connector-java-8.0.33.jar lib/HikariCP-4.0.3.jar lib/slf4j-api-1.7.36.jar lib/slf4j-jdk14-1.7.36.jar"/>
            </manifest>
        </jar>

        <!-- Create portable run-server.bat for RMI Server -->
        <echo file="${server.dist.dir}/run-server.bat">@echo off
setlocal
cd /d "%~dp0"

where java &gt;nul 2&gt;&amp;1
if errorlevel 1 (
    echo [ERROR] Java Runtime Environment ^(java^) was not found in PATH.
    echo Please install Java 8+ and add it to your system PATH.
    pause
    exit /b 1
)

echo Starting Remote School Library Java RMI Server...
java -cp "resources;server.jar;lib/*" thuvien.server.rmi.LibraryRMIServer %*
endlocal
</echo>
        <echo message="[ANT] Server distribution created at: ${server.dist.dir}"/>
    </target>

    <target name="package-client" depends="compile" description="Packages isolated Client distribution into dist/client-dist">
        <property name="client.dist.dir" value="${dist.dir}/client-dist"/>
        <delete dir="${client.dist.dir}"/>
        <mkdir dir="${client.dist.dir}"/>
        <mkdir dir="${client.dist.dir}/lib"/>
        <mkdir dir="${client.dist.dir}/resources"/>

        <!-- Copy externalized Client configuration -->
        <copy todir="${client.dist.dir}/resources" failonerror="false">
            <fileset dir="client/resources" includes="client.properties"/>
        </copy>

        <!-- Build client.jar with ONLY common + client classes (ZERO server classes, ZERO db.properties, ZERO JDBC JARs) -->
        <jar destfile="${client.dist.dir}/client.jar">
            <fileset dir="${build.classes.dir}">
                <include name="thuvien/common/**"/>
                <include name="thuvien/client/**"/>
                <include name="client.properties"/>
                <exclude name="thuvien/server/**"/>
                <exclude name="db.properties"/>
                <exclude name="db.properties.example"/>
                <exclude name="server.properties"/>
            </fileset>
            <manifest>
                <attribute name="Main-Class" value="thuvien.client.ClientMain"/>
                <attribute name="Class-Path" value="resources/"/>
            </manifest>
        </jar>

        <!-- Create portable run-client.bat supporting optional [host] [port] arguments -->
        <echo file="${client.dist.dir}/run-client.bat">@echo off
setlocal
cd /d "%~dp0"

where java &gt;nul 2&gt;&amp;1
if errorlevel 1 (
    echo [ERROR] Java Runtime Environment ^(java^) was not found in PATH.
    echo Please install Java 8+ and add it to your system PATH.
    pause
    exit /b 1
)

set "JVM_ARGS="
if not "%~1"=="" set "JVM_ARGS=-Drmi.server.host=%~1 -Dserver.host=%~1"
if not "%~2"=="" set "JVM_ARGS=%JVM_ARGS% -Drmi.registry.port=%~2 -Dserver.port=%~2"

echo Starting Remote School Library Java RMI Swing Client...
java %JVM_ARGS% -cp "resources;client.jar;lib/*" thuvien.client.ClientMain %*
endlocal
</echo>
        <echo message="[ANT] Client distribution created at: ${client.dist.dir}"/>
    </target>

    <target name="package-all" depends="jar,package-server,package-client" description="Builds all Server and Client distributions"/>
</project>
